{
  "manifest_version": 3,
  "name": "UNI Bocchi Bridge",
  "version": "1.3.0",
  "description": "Puente local entre UNI Bocchi Monitor, Matrícula UNI y UniVirtual, con vacantes y consulta manual de participantes de aulas accesibles.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://matricula-alumno.uni.edu.pe/*",
    "https://univirtual.uni.pe/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://matricula-alumno.uni.edu.pe/*"
      ],
      "js": [
        "uni-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://univirtual.uni.pe/*"
      ],
      "js": [
        "moodle-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://uni-bocchi-monitor.vercel.app/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "UNI Bocchi Bridge"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uni-bocchi-monitor@local.invalid",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {}
  }
}
